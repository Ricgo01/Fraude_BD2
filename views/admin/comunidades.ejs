<%- include('../partials/header', { title }) %>
<%- include('../partials/navbar', { title, role }) %>

<div class="layout">
  <%- include('../partials/sidebar', { role }) %>
  <main class="content">

    <!-- Seccion 1: Header y botones -->
    <div class="page-header">
      <h1>Analisis de Comunidades</h1>
      <p>Detecta grupos de estudiantes densamente conectados mediante un algoritmo de deteccion de comunidades (inspirado en Louvain).</p>
    </div>

    <section class="section">
      <div class="actions">
        <button class="btn btn-primary" id="btn-ejecutar" onclick="ejecutarAnalisis()">Ejecutar Analisis</button>
        <button class="btn btn-danger" onclick="limpiarResultados()">Limpiar resultados (demo)</button>
      </div>
    </section>

    <!-- Seccion 2: KPIs -->
    <div id="kpis-section" style="display: none; margin-bottom: 24px;">
      <div class="cards" style="grid-template-columns: repeat(3, 1fr);">
        <div class="card">
          <h3>Comunidades sospechosas</h3>
          <strong id="kpi-comunidades">0</strong>
        </div>
        <div class="card">
          <h3>Estudiantes en riesgo</h3>
          <strong id="kpi-en-riesgo">0</strong>
        </div>
        <div class="card">
          <h3>Mayor comunidad detectada</h3>
          <strong><span id="kpi-mayor">0</span> <small style="font-size: 16px; color: var(--gray-text);">estudiantes</small></strong>
        </div>
      </div>
    </div>

    <!-- Secciones 3 y 4 en grid -->
    <div class="grid-2">

      <!-- Seccion 3: Comunidades detectadas -->
      <section class="section">
        <h2>Comunidades sospechosas</h2>
        <p>Grupos de estudiantes densamente conectados. Un estudiante en multiples grupos indica mayor riesgo.</p>
        <div class="table-wrapper" style="max-height: 500px; overflow-y: auto;">
          <table class="table">
            <thead>
              <tr>
                <th>#</th>
                <th>Estudiantes</th>
                <th>Miembros</th>
                <th>Score maximo</th>
                <th>Accion</th>
              </tr>
            </thead>
            <tbody id="comunidades-table">
              <tr><td colspan="5">El analisis no ha sido ejecutado. Presiona Ejecutar Analisis para comenzar.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Seccion 4: Top sospechosos -->
      <section class="section">
        <h2>Estudiantes con mayor score de sospecha</h2>
        <p>Calculado segun los recursos compartidos con otros estudiantes. Mayor puntaje indica mayor riesgo.</p>
        <div class="table-wrapper" style="max-height: 500px; overflow-y: auto;">
          <table class="table">
            <thead>
              <tr>
                <th>#</th>
                <th>Estudiante</th>
                <th>Email</th>
                <th>Score</th>
                <th>Comparte</th>
              </tr>
            </thead>
            <tbody id="sospechosos-table">
              <tr><td colspan="5">El analisis no ha sido ejecutado. Presiona Ejecutar Analisis para comenzar.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>

  </main>
</div>

<!-- Modal detalle de comunidad -->
<div id="modal-overlay" onclick="cerrarModalOverlay(event)" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
  <div style="background: white; border-radius: 16px; padding: 32px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto; position: relative;">
    <button onclick="cerrarModal()" style="position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 22px; cursor: pointer; color: var(--gray-text); line-height: 1;">&times;</button>
    <h2 id="modal-title" style="margin-top: 0; margin-bottom: 16px;"></h2>
    <div id="modal-content"></div>
  </div>
</div>

<%- include('../partials/footer', { pageScript: '/js/pages/admin-comunidades.js' }) %>
